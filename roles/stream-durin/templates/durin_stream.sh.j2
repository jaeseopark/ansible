#!/bin/bash

while true; do
  if ffprobe -v error -rtsp_transport tcp -i "{{ ffmpeg_rtsp_url }}" &> /dev/null; then
    echo "RTSP stream is available. Starting ffmpeg..."
    ffmpeg -loglevel error -rtsp_transport tcp -fflags +genpts+discardcorrupt \
      -avoid_negative_ts make_zero -vsync 1 \
      -i "{{ ffmpeg_rtsp_url }}" \
      -vcodec copy -acodec aac -ar 44100 -ab 128k -af "volume=0" \
      -f flv "{{ yt_rtmp_url }}"
    echo "FFmpeg process ended. Restarting after a short delay..."
    sleep 5 # Wait 5 seconds before attempting to restart
  else
    echo "RTSP stream is not available. Waiting for 30 seconds before checking again."
    sleep 30 # Wait 30 seconds before re-checking the stream
  fi
done
