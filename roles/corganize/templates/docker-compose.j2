version: "3"
services:
  nginx:
    image: nginx
    volumes:
      - {{ app_path }}/setup-nginx-worker-user.sh:/docker-entrypoint.d/00-setup-worker-user.sh:ro
      - {{ app_path }}/nginx/templates/dev.conf.template:/etc/nginx/templates/default.conf.template:ro
      - {{ data_mnt_path }}/data:/data:ro
    ports:
      - {{ app_object.port }}:80
    depends_on:
      - "ui"
      - "api"
    env_file:
      - .env
  ui:
    build:
      context: .
      dockerfile: ./crgw-ui/Dockerfile
    working_dir: /app
    volumes:
      - crgw-ui-node-modules:/app/node_modules
    env_file:
      - .env
  api:
    build:
      context: .
      dockerfile: ./crgw-api/Dockerfile
    working_dir: /app
    stop_signal: SIGINT # https://github.com/docker/compose/issues/4199#issuecomment-426109482
    volumes:
      - {{ app_path }}/crgw-api:/app
      - {{ data_mnt_path }}/data:/data
      - {{ log_path }}:/var/log/crgw-api
    env_file:
      - .env
  daemon:
    container_name: daemon
    build:
      context: .
      dockerfile: ./crgw-daemon/Dockerfile
    restart: unless-stopped
    env_file:
      - .env
    volumes:
      - {{ data_mnt_path }}:/mnt
      - {{ log_path }}:/var/log/crgw-daemon

volumes:
  crgw-ui-node-modules:
